{
    "name": "@vincentgloss/node-red-dashboard-2-ui-switch-options",
    "version": "1.1.1",
    "description": "Option switcher for Node-RED FlowFuse Dashboard 2.0: step through a list of options with previous and next buttons, set options and selection from your flow, Material Design icons and own colors",
    "keywords": [
        "node-red",
        "node-red-dashboard-2",
        "flowfuse",
        "flowfuse-dashboard",
        "dashboard",
        "dashboard-2",
        "ui",
        "widget",
        "switch",
        "option-switcher",
        "selector",
        "carousel",
        "previous-next",
        "stepper",
        "material-design-icons",
        "vue"
    ],
    "homepage": "https://github.com/vincentgloss/node-red-dashboard-2-ui-switch-options#readme",
    "bugs": {
        "url": "https://github.com/vincentgloss/node-red-dashboard-2-ui-switch-options/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vincentgloss/node-red-dashboard-2-ui-switch-options.git"
    },
    "license": "Apache-2.0",
    "author": {
        "name": "Vincent Gloß",
        "url": "https://github.com/vincentgloss"
    },
    "files": [
        "nodes/",
        "resources/",
        "examples/",
        "LICENSE",
        "README.md",
        "README.de.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "vite build",
        "build:dev": "vite build --mode development",
        "dev": "vite build --mode development --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "6.0.10",
        "eslint": "10.13.0",
        "eslint-plugin-vue": "10.11.1",
        "globals": "17.13.0",
        "neostandard": "0.14.1",
        "vite": "8.3.4",
        "vite-plugin-css-injected-by-js": "5.0.2",
        "vue": "3.5.44"
    },
    "peerDependencies": {
        "@flowfuse/node-red-dashboard": ">=1.23.0 <2"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
